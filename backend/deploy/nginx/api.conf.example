# Referencia. No está desplegada. Sustituya certificados, dominio y el upstream real.
# No registre query strings: las credenciales de XUI no deben llegar a este proxy,
# y las referencias de reproducción no deben escribirse en access_log.

server {
    listen 443 ssl;
    server_name api.example.invalid;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    client_max_body_size 16k;
    client_body_timeout 10s;
    proxy_read_timeout 30s;
    proxy_connect_timeout 5s;

    log_format cotas_api '$remote_addr - $status "$request_method $uri"';
    access_log /var/log/nginx/cotas-api.access.log cotas_api;

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Correlation-Id $request_id;
    }

    location /api/v1/health/live {
        proxy_pass http://127.0.0.1:3000;
        access_log off;
    }
}
