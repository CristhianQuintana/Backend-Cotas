# Referencia para api.cotasperu.com (o el dominio que corresponda).
# Sustituya rutas de certificados. Upstream Nest en 127.0.0.1:3100.
# No registre query strings: tickets de media y firmas no deben ir al access_log.

upstream cotas_backend {
    server 127.0.0.1:3100;
    keepalive 16;
}

server {
    listen 80;
    server_name api.cotasperu.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.cotasperu.com;

    ssl_certificate     /etc/letsencrypt/live/api.cotasperu.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.cotasperu.com/privkey.pem;

    client_max_body_size 16k;
    client_body_timeout 10s;
    proxy_connect_timeout 5s;

    log_format cotas_api '$remote_addr - $status "$request_method $uri"';
    access_log /var/log/nginx/cotas-api.access.log cotas_api;

    location /api/v1/health/live {
        proxy_pass http://cotas_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
    }

    # HLS/VOD vía proxy de tickets: timeouts largos y sin buffer.
    location /api/v1/playback/media/ {
        proxy_pass http://cotas_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Correlation-Id $request_id;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /api/ {
        proxy_pass http://cotas_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Correlation-Id $request_id;
        proxy_read_timeout 60s;
    }
}
