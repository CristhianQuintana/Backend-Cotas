generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum IptvAccountStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  ERROR
}

enum MfaMethodType {
  TOTP
}

enum MfaMethodStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
  TV
  OTHER
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum SessionRevocationReason {
  LOGOUT
  ROTATED
  REUSE
  ADMIN
  SECURITY
}

enum AuditResult {
  success
  failure
  pending
}

enum AuthChallengePurpose {
  MFA_RECOVERY
}

enum DeviceLinkStatus {
  PENDING
  APPROVED
  EXPIRED
  DENIED
  CONSUMED
}

model User {
  id              String     @id @db.Uuid
  email           String?    @db.VarChar(254)
  phone           String?    @db.VarChar(32)
  username        String?    @db.VarChar(64)
  displayName        String?    @map("display_name") @db.VarChar(120)
  passwordHash       String?    @map("password_hash")
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  status             UserStatus @default(PENDING)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt    DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  userRoles      UserRoleLink[]
  sessions       UserSession[]
  devices        Device[]
  mfaMethods     UserMfaMethod[]
  iptvAccounts   IptvAccount[]
  reminders           AccountReminder[]
  auditLogs           AuditLog[]
  authChallenges      AuthChallenge[]
  deviceLinkApprovals DeviceLinkChallenge[] @relation("DeviceLinkApprover")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

enum AccountReminderState {
  scheduled
  cancelled
  unverifiable
}

model AccountReminder {
  id           String               @id @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  channelId    String               @map("channel_id") @db.VarChar(64)
  channelName  String               @map("channel_name") @db.VarChar(160)
  programTitle String               @map("program_title") @db.VarChar(240)
  epgProgramId String?              @map("epg_program_id") @db.VarChar(64)
  /// Clave de deduplicación: epg_program_id o program_title.
  programKey   String               @map("program_key") @db.VarChar(240)
  leadMinutes  Int                  @map("lead_minutes")
  state        AccountReminderState @default(scheduled)
  startAt      DateTime?            @map("start_at") @db.Timestamptz(3)
  endAt        DateTime?            @map("end_at") @db.Timestamptz(3)
  notifyAt     DateTime?            @map("notify_at") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state])
  @@index([userId, notifyAt])
  @@map("account_reminders")
}

model Role {
  id          String   @id @db.Uuid
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(240)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles       UserRoleLink[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @db.Uuid
  code        String   @unique @db.VarChar(64)
  description String?  @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRoleLink {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Device {
  id                   String         @id @db.Uuid
  userId               String         @map("user_id") @db.Uuid
  platform             DevicePlatform
  deviceName           String?        @map("device_name") @db.VarChar(80)
  deviceIdentifierHash String         @map("device_identifier_hash") @db.VarChar(64)
  pushToken            String?        @map("push_token") @db.VarChar(512)
  pushPlatform         String?        @map("push_platform") @db.VarChar(32)
  status               DeviceStatus   @default(ACTIVE)
  lastSeenAt           DateTime?      @map("last_seen_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt            DateTime?      @map("revoked_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@unique([userId, deviceIdentifierHash])
  @@index([userId, status])
  @@index([pushToken])
  @@map("devices")
}

model UserSession {
  id               String                   @id @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  deviceId         String?                  @map("device_id") @db.Uuid
  familyId         String                   @map("family_id") @db.Uuid
  refreshTokenHash String                   @unique @map("refresh_token_hash") @db.VarChar(64)
  ipAddress        String?                  @map("ip_address") @db.VarChar(64)
  userAgent        String?                  @map("user_agent") @db.VarChar(256)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime?                @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokeReason     SessionRevocationReason? @map("revoke_reason")
  replacedById     String?                  @map("replaced_by_id") @db.Uuid

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
  @@map("user_sessions")
}

model UserMfaMethod {
  id              String          @id @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  method          MfaMethodType
  secretEncrypted String?         @map("secret_encrypted")
  status          MfaMethodStatus @default(PENDING)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt     DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_mfa_methods")
}

model IptvAccount {
  id                   String            @id @db.Uuid
  userId               String            @map("user_id") @db.Uuid
  provider             String            @default("XUI") @db.VarChar(32)
  externalAccountRef   String?           @map("external_account_ref") @db.VarChar(128)
  username             String?           @db.VarChar(64)
  passwordEncrypted    String?           @map("password_encrypted")
  status               IptvAccountStatus @default(ACTIVE)
  expiresAt            DateTime?         @map("expires_at") @db.Timestamptz(3)
  maxConnections       Int?              @map("max_connections")
  activeConnections    Int?              @map("active_connections")
  displayNameSnapshot  String?           @map("display_name_snapshot") @db.VarChar(120)
  lastVerifiedAt       DateTime?         @map("last_verified_at") @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("iptv_accounts")
}

model CatalogContentSnapshot {
  id         String   @id @db.Uuid
  provider   String   @default("XUI") @db.VarChar(32)
  resource   String   @db.VarChar(16)
  contentIds Json     @map("content_ids")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, resource])
  @@map("catalog_content_snapshots")
}

model CatalogAnnouncement {
  id        String   @id @db.Uuid
  kind      String   @db.VarChar(16)
  title     String   @db.VarChar(240)
  contentId String   @map("content_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([kind, createdAt])
  @@map("catalog_announcements")
}

model AuditLog {
  id            String      @id @db.Uuid
  actorUserId   String?     @map("actor_user_id") @db.Uuid
  action        String      @db.VarChar(64)
  resourceType  String      @map("resource_type") @db.VarChar(64)
  resourceId    String?     @map("resource_id") @db.VarChar(64)
  result        AuditResult
  ipAddress     String?     @map("ip_address") @db.VarChar(64)
  correlationId String?     @map("correlation_id") @db.VarChar(64)
  metadata      Json?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model AuthChallenge {
  id         String               @id @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  purpose    AuthChallengePurpose
  tokenHash  String               @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime             @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?            @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_challenges")
}

/// Código de un solo uso para login TV vía QR (móvil aprueba → TV canjea tokens propios).
model DeviceLinkChallenge {
  id                     String           @id @db.Uuid
  codeHash               String           @unique @map("code_hash") @db.VarChar(64)
  /// Identificador estable del TV (UUID de instalación). No es secreto; el secreto es el código.
  tvClientDeviceId       String           @map("tv_client_device_id") @db.VarChar(128)
  /// Hash del id (lookup / integridad con claimDeviceSlot).
  tvClientDeviceIdHash   String           @map("tv_client_device_id_hash") @db.VarChar(64)
  platform               DevicePlatform
  deviceName             String?          @map("device_name") @db.VarChar(80)
  status                 DeviceLinkStatus @default(PENDING)
  expiresAt              DateTime         @map("expires_at") @db.Timestamptz(3)
  approvedAt             DateTime?        @map("approved_at") @db.Timestamptz(3)
  consumedAt             DateTime?        @map("consumed_at") @db.Timestamptz(3)
  /// Usuario que aprobó desde el móvil.
  approverUserId         String?          @map("approver_user_id") @db.Uuid
  /// Fila devices creada/reclamada al aprobar.
  deviceId               String?          @map("device_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  approver User? @relation("DeviceLinkApprover", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([tvClientDeviceIdHash, status])
  @@map("device_link_challenges")
}
