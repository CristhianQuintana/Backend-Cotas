generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum IptvAccountStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  ERROR
}

enum MfaMethodType {
  TOTP
}

enum MfaMethodStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
  TV
  OTHER
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum SessionRevocationReason {
  LOGOUT
  ROTATED
  REUSE
  ADMIN
  SECURITY
}

enum AuditResult {
  success
  failure
  pending
}

enum AuthChallengePurpose {
  MFA_RECOVERY
}

model User {
  id              String     @id @db.Uuid
  email           String?    @db.VarChar(254)
  phone           String?    @db.VarChar(32)
  username        String?    @db.VarChar(64)
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  userRoles      UserRoleLink[]
  sessions       UserSession[]
  devices        Device[]
  mfaMethods     UserMfaMethod[]
  iptvAccounts   IptvAccount[]
  auditLogs      AuditLog[]
  authChallenges AuthChallenge[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @db.Uuid
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(240)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles       UserRoleLink[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @db.Uuid
  code        String   @unique @db.VarChar(64)
  description String?  @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRoleLink {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Device {
  id                   String         @id @db.Uuid
  userId               String         @map("user_id") @db.Uuid
  platform             DevicePlatform
  deviceName           String?        @map("device_name") @db.VarChar(80)
  deviceIdentifierHash String         @map("device_identifier_hash") @db.VarChar(64)
  status               DeviceStatus   @default(ACTIVE)
  lastSeenAt           DateTime?      @map("last_seen_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt            DateTime?      @map("revoked_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@index([userId, status])
  @@map("devices")
}

model UserSession {
  id               String                   @id @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  deviceId         String?                  @map("device_id") @db.Uuid
  familyId         String                   @map("family_id") @db.Uuid
  refreshTokenHash String                   @unique @map("refresh_token_hash") @db.VarChar(64)
  ipAddress        String?                  @map("ip_address") @db.VarChar(64)
  userAgent        String?                  @map("user_agent") @db.VarChar(256)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime?                @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokeReason     SessionRevocationReason? @map("revoke_reason")
  replacedById     String?                  @map("replaced_by_id") @db.Uuid

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
  @@map("user_sessions")
}

model UserMfaMethod {
  id              String          @id @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  method          MfaMethodType
  secretEncrypted String?         @map("secret_encrypted")
  status          MfaMethodStatus @default(PENDING)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt     DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_mfa_methods")
}

model IptvAccount {
  id                 String            @id @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  provider           String            @default("XUI") @db.VarChar(32)
  externalAccountRef String?           @map("external_account_ref") @db.VarChar(128)
  username           String?           @db.VarChar(64)
  passwordEncrypted  String?           @map("password_encrypted")
  status             IptvAccountStatus @default(ACTIVE)
  expiresAt          DateTime?         @map("expires_at") @db.Timestamptz(3)
  lastVerifiedAt     DateTime?         @map("last_verified_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("iptv_accounts")
}

model AuditLog {
  id            String      @id @db.Uuid
  actorUserId   String?     @map("actor_user_id") @db.Uuid
  action        String      @db.VarChar(64)
  resourceType  String      @map("resource_type") @db.VarChar(64)
  resourceId    String?     @map("resource_id") @db.VarChar(64)
  result        AuditResult
  ipAddress     String?     @map("ip_address") @db.VarChar(64)
  correlationId String?     @map("correlation_id") @db.VarChar(64)
  metadata      Json?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model AuthChallenge {
  id         String               @id @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  purpose    AuthChallengePurpose
  tokenHash  String               @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime             @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?            @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_challenges")
}
