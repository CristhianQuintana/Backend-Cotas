# Valores ficticios. Cualquier secreto que contenga CHANGE_ME es rechazado al iniciar.
# Copie este archivo a .env y sustituya cada secreto. No versione .env.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info

DATABASE_URL=postgresql://cotas:local_only_dev_password@127.0.0.1:5436/cotas_dev

JWT_ACCESS_SECRET=CHANGE_ME_jwt_access_secret_minimo_32
JWT_ISSUER=cotas.local
JWT_AUDIENCE=cotas-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
MFA_ENCRYPTION_KEY=CHANGE_ME_mfa_encryption_key_minimo_32

XUI_BASE_URL=http://xui.local
XUI_USERNAME=CHANGE_ME_xui_user
XUI_PASSWORD=CHANGE_ME_xui_password
XUI_TIMEOUT_MS=5000
XUI_MAX_RESPONSE_BYTES=2000000
XUI_ALLOWED_STREAM_HOSTS=xui.local
XUI_ALLOW_INSECURE_HTTP=false

CORS_ORIGINS=http://localhost:3000
# El contenedor arranca en production y no acepta orígenes http.
# En el servidor use el origen https real, por ejemplo:
# PUBLIC_CORS_ORIGINS=https://api.example.invalid
# POSTGRES_PASSWORD debe definirse antes del primer arranque en un servidor nuevo.
# POSTGRES_USER=cotas
# POSTGRES_DB=cotas_dev
# BACKEND_PORT=3100
# POSTGRES_PORT=5436
TRUST_PROXY=false
SWAGGER_ENABLED=true
BODY_LIMIT=16kb
SENSITIVE_RATE_LIMIT=10
SENSITIVE_RATE_TTL_MS=60000
GLOBAL_RATE_LIMIT=300

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Solo para `npm run seed`. No son contraseñas de clientes.
# Opcional. Asigna el rol OPERATOR a este usuario. El ingreso sigue siendo la línea XUI.
# SEED_OPERATOR_USERNAME=operator.local
# SEED_ALLOW_PRODUCTION=false
