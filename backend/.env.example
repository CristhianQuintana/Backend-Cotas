# Valores ficticios. Cualquier secreto que contenga CHANGE_ME es rechazado al iniciar.
# Copie este archivo a .env y sustituya cada secreto. No versione .env.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info

DATABASE_URL=postgresql://cotas:local_only_dev_password@127.0.0.1:5436/cotas_dev

JWT_ACCESS_SECRET=CHANGE_ME_jwt_access_secret_minimo_32
JWT_ISSUER=cotas.local
JWT_AUDIENCE=cotas-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
MFA_ENCRYPTION_KEY=CHANGE_ME_mfa_encryption_key_minimo_32

XUI_BASE_URL=http://xui.local
XUI_USERNAME=CHANGE_ME_xui_user
XUI_PASSWORD=CHANGE_ME_xui_password
# El panel medido el 21/10/2026 respondió cerca de 10 s. El máximo que acepta la aplicación es 30000.
XUI_TIMEOUT_MS=20000
XUI_MAX_RESPONSE_BYTES=2000000
XUI_ALLOWED_STREAM_HOSTS=xui.local
# En production, una XUI_BASE_URL http solo arranca si esta variable es true.
XUI_ALLOW_INSECURE_HTTP=false

CORS_ORIGINS=http://localhost:3000
# El contenedor arranca en production. Por defecto solo acepta orígenes https.
# En la red de pruebas (Tizen / Live Server) puede permitir http con:
# CORS_ALLOW_INSECURE_HTTP=true
# PUBLIC_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# En release con TLS use solo https, por ejemplo:
# PUBLIC_CORS_ORIGINS=https://tv.example.invalid
# CORS_ALLOW_INSECURE_HTTP=false
# POSTGRES_PASSWORD debe definirse antes del primer arranque en un servidor nuevo.
# POSTGRES_USER=cotas
# POSTGRES_DB=cotas_dev
# BACKEND_PORT=3100
# POSTGRES_PORT=5436
TRUST_PROXY=false
SWAGGER_ENABLED=true
BODY_LIMIT=16kb
SENSITIVE_RATE_LIMIT=10
SENSITIVE_RATE_TTL_MS=60000
GLOBAL_RATE_LIMIT=300

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Redis / caché de catálogo (Compose levanta el servicio `redis` solo en red interna).
# En production REDIS_PASSWORD es obligatorio y no puede contener CHANGE_ME.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=CHANGE_ME_redis_password_minimo
# REDIS_MAXMEMORY=256mb
CATALOG_CACHE_TTL_SECONDS=300
CATALOG_EPG_CACHE_TTL_SECONDS=120
CATALOG_SYNC_INTERVAL_MS=300000
CATALOG_SYNC_CONCURRENCY=1

# Solo para `npm run seed`. Crea personal con contraseña local (Argon2id), no usa XUI.
# SEED_OPERATOR_USERNAME=operador
# SEED_OPERATOR_PASSWORD=CHANGE_ME_operator_password_12
# SEED_ADMIN_USERNAME=admin.local
# SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password_12chars
# SEED_ALLOW_PRODUCTION=false
