  "info": {
    "title": "COTAS Backend",
    "description": "API de identidad, catálogo y autorización de reproducción. El vídeo no atraviesa esta API. Las referencias de reproducción pueden incluir material de acceso exigido por la infraestructura verificada y no deben registrarse.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "viewer.demo",
            "minLength": 3,
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "totpCode": {
            "type": "string",
            "example": "123456"
          },
          "recoveryCode": {
            "type": "string",
            "example": "abcde-fghij"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "RefreshRequestDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ConfirmMfaRequestDto": {
        "type": "object",
        "properties": {
          "totpCode": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "totpCode"
        ]
      },
      "CreateAdminUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "operador"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "OPERATOR",
              "ADMIN"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "SUSPENDED",
              "DISABLED"
            ],
            "default": "ACTIVE"
          }
        },
        "required": [
          "username",
          "password",
          "role"
        ]
      },
      "UpdateAdminUserDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "SUSPENDED",
              "DISABLED"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "OPERATOR",
              "ADMIN"
            ]
          }
        }
      },
      "ResetAdminUserPasswordDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "password"
        ]
      },
      "AuthorizePlaybackDto": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "enum": [
              "live",
              "vod",
              "series"
            ]
          },
          "streamId": {
            "type": "string",
            "example": "1001"
          },
          "seriesId": {
            "type": "string",
            "example": "1"
          },
          "seasonNumber": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "contentType",
          "streamId"
        ]
      }
    }
  }
}
